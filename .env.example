# Tesla developer app ("India Update Tracker")
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=
# Optional. Defaults to https://fleet-api.prd.na.vn.cloud.tesla.com (North America + Asia-Pacific, incl. India)
TESLA_FLEET_API_BASE_URL=
# PEM from scripts/generate-keys.mjs, served at /.well-known/appspecific/com.tesla.3p.public-key.pem
TESLA_PUBLIC_KEY_PEM=
# Not used at runtime (read-only app). Only needed if vehicle commands are added later.
TESLA_PRIVATE_KEY_PEM=
# Optional. Domain for scripts/register-partner.mjs. Defaults to app.getuplink.in
TESLA_PARTNER_DOMAIN=

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App secrets
# 32 random bytes, base64: openssl rand -base64 32. Encrypts Tesla tokens and signs session cookies.
TOKEN_ENCRYPTION_KEY=
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional. Random string; GET /api/health/stream wants "Authorization: Bearer <HEALTH_TOKEN>"
HEALTH_TOKEN=
# Optional. 1 asks Tesla for the vehicle_location scope (enable it in the Tesla developer app first)
TESLA_LOCATION_SCOPE=
# Optional. closed (default) | invite | waitlist | open (acts as waitlist for now). Who may sign up.
# invite: an unknown Tesla account joins only through an invite link (Admin > Access); invite links work in
# every mode but closed.
SIGNUP_MODE=
# Optional. How many accounts can be approved at once, the admin included. Default 25.
MAX_USERS=
# Optional. Monthly Tesla Fleet API budget in USD, by Uplink's estimate. Checks slow at 80%, pause at 100%.
# Default 10, Tesla's monthly credit.
TESLA_BUDGET_USD=
# The admin is users.role = 'admin' in the database, not an env var.

# Place names (docs/place-names.md)
# Optional. Server-side Google key (Places API (New) + Geocoding API) for the read-only hints in "Name this place".
GOOGLE_MAPS_API_KEY=
# Optional. An email or URL OpenStreetMap's operators can reach, sent in the Nominatim User-Agent.
OSM_CONTACT=
# Optional. off stops every Nominatim lookup.
OSM_LOOKUPS=
