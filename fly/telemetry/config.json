{
  "host": "0.0.0.0",
  "port": 8443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "uplink_telemetry",
  "reliable_ack": false,
  "rate_limit": {
    "enabled": true,
    "message_interval_time": 30,
    "message_limit": 1000
  },
  "logger": {
    "verbose": false
  },
  "records": {
    "errors": ["logger"],
    "V": ["logger"]
  },
  "tls": {
    "server_cert": "/tmp/certs/tls.crt",
    "server_key": "/tmp/certs/tls.key"
  }
}
